# Copy to .env.local and fill in your own values. Never commit .env.local.

# Supabase client credentials (safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=your-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: used by app/api routes. Never prefix with NEXT_PUBLIC_.
# Looking for my old key in the git history? LOL good luck trying to use my api key, it has 20 cents. Go for it.
ANTHROPIC_API_KEY=your-key-here

# Only for upload.py (bypasses RLS). Never prefix with NEXT_PUBLIC_, never use in the app.
SUPABASE_SERVICE_ROLE_KEY=your-key-here
